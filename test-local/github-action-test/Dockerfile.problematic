FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# This syntax is broken on purpose - notice the escaped asterisk and the misplaced &&
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/\* 

CMD ["/bin/bash"]
